# Copy to secrets.yaml and fill in real values. Never commit secrets.yaml.
backend_webhook_secret: change-me-to-a-random-string

# Used by Home Assistant integrations (Spotify, etc.) — add as needed during setup.
# spotify_client_id:
# spotify_client_secret:

# Only needed if Sonos auto-discovery doesn't find your speaker (common when running
# Home Assistant in Docker, since SSDP discovery relies on multicast that bridge
# networks typically block). See docs/SETUP.md for details.
# sonos_host: 192.168.1.x            # Sonos speaker's LAN IP
# sonos_advertise_addr: 192.168.1.x  # The Docker host machine's own LAN IP

# Also needed on Docker Desktop for Mac: without it, HA advertises its internal VM
# address in generated media URLs (e.g. TTS clips), which LAN devices can't reach.
# ha_internal_url: http://192.168.1.x:8123

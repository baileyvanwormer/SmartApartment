# Copy to .env and fill in real values. Never commit .env.
# Timezone for the Home Assistant container.
TZ=America/New_York

# Home Assistant → Profile → Security → Long-Lived Access Tokens
HA_URL=http://homeassistant:8123
HA_TOKEN=

# HA → Settings → Devices & services → Entities → your Sonos speaker
HA_SONOS_ENTITY=media_player.living_room

# Entity IDs for the two Hue scenes (create them in the Hue app first)
HA_HUE_SCENE_DOUBLE=scene.apartment_relax
HA_HUE_SCENE_TRIPLE=scene.apartment_party

# Person entity used for welcome-home presence checks
HA_PERSON_ENTITY=person.bailey

# Full Spotify playlist URL, e.g. https://open.spotify.com/playlist/xxxxxxxx
SPOTIFY_PLAYLIST_URL=

# How long after arrival a long-press still triggers the welcome greeting
WELCOME_HOME_ARRIVAL_WINDOW_MINUTES=15
WELCOME_HOME_MESSAGE=Hello Bailey, welcome home

# Shared secret checked against the X-Webhook-Secret header on all POST endpoints.
# Must match backend_webhook_secret in home-assistant/secrets.yaml. Leave blank to disable the check.
BACKEND_WEBHOOK_SECRET=
